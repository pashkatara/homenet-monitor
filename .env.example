# ==============================================================================
# HomeNet Monitor — Конфигурация окружения
# ==============================================================================

# Порт веб-интерфейса
PORT=3001

# Часовой пояс сервера (например, Europe/Moscow, Asia/Omsk, Europe/Kaliningrad, UTC)
TZ=Europe/Moscow

# Подсеть и шлюз локальной сети
SUBNET_PREFIX=192.168.1.
GATEWAY_IP=192.168.1.1
WAN_TARGET=1.1.1.1

# Настройки роутера (keenetic | openwrt | none)
ROUTER_TYPE=keenetic
ROUTER_IP=192.168.1.1
ROUTER_PORT=80
ROUTER_PROTO=http
ROUTER_USER=admin
ROUTER_PASS=
ROUTER_WAN_IFACE=PPPoE0
ROUTER_NAME=Wi-Fi Router

# Telegram-уведомления (можно также настроить через веб-интерфейс)
TG_TOKEN=
TG_CHAT_ID=

# Опционально: SSH-доступ к хост-серверу для вкладки «Сервер» и вызова терминала
# HOST_SSH_USER=admin
# HOST_SSH_PASS=
# HOST_SSH_IP=127.0.0.1
# HOST_SSH_PORT=22
